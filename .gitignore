.venv/
out/
__pycache__/
*.egg-info/
*.pyc
*-erc.rpt
*.kicad_prl
fp-info-cache

# Downloaded LCSC/JLC parts catalogue (defaults to ~/.kicad-flow/, but ignore
# any copy that lands in the tree) and its partial downloads.
*.sqlite3
*.sqlite3.part
.kicad-flow/

# Generated manufacturing files (BOM / pick-and-place).
*-bom.csv
*-pos.csv
*-cpl.csv

# Runtime logs (freerouting, etc.) -- never commit these.
logs/

# Rendered previews written during development
*.png
# ...except the example showcases, which are the point of examples/<name>/.
# Regenerate with render.export_png on the built sheet; see the README.
!examples/*/*.png

# Generated by examples/scripts/build_via_mcp.py on every run (it rmtree-s
# first). The script is the artefact; the project is its output.
examples/mcp_demo/
examples/multisheet/logs/

# The board example rebuilds its output; only the render is worth keeping.
examples/usb_ttl1_pcb/*.kicad_pcb

# The LED example rebuilds its boards; the renders are the artefact.
examples/led_matrix/*.kicad_pcb
examples/led_matrix/*.kicad_sch

# The LED example rebuilds its boards; the renders are the artefact.
examples/led_matrix/*.kicad_pcb
examples/led_matrix/*.kicad_sch
examples/led_matrix/*.kicad_pro
# led_digits is 320 parts: 11 schematic pages and a board of generated
# geometry. The two board renders are what is worth reading; the rest is
# rebuilt by the script in 23 seconds.
examples/led_digits/*.kicad_pcb
examples/led_digits/*.kicad_sch
examples/led_digits/*.kicad_pro
examples/led_digits/led_digits-[0-9]*.png
examples/usb_ttl1_pcb/*.kicad_pro

# The digits board rebuilds itself; the two renders are the artefact.
examples/led_digits/*.kicad_pcb
examples/led_digits/*.kicad_pro
